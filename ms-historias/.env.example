# Copie este archivo como .env y ajuste los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# Puerto de este microservicio (ms-usuarios usa el 3001)
PORT=3005
# 127.0.0.1 = solo acepta conexiones desde el mismo equipo
HOST=127.0.0.1

# Base de datos MySQL de este microservicio
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=historias_db
DB_USER=historias_user
DB_PASSWORD=una-clave-segura

# La misma clave que usa ms-usuarios para firmar los tokens JWT
# (el grupo la comparte por un medio privado, nunca en el repositorio)
JWT_SECRET=cambie-esta-frase-por-una-larga-y-secreta

# Direcciones de los microservicios que consulta ms-historias
PACIENTES_URL=http://127.0.0.1:3002
MEDICOS_URL=http://127.0.0.1:3003
# Copie este archivo como .env y ajuste los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# Puerto donde escucha este microservicio.
# ms-usuarios usa el 3001; los microservicios de los estudiantes, del 3002 en adelante.
PORT=3005
# 127.0.0.1 = solo acepta conexiones desde el mismo equipo (el gateway Apache estará en ese mismo equipo)
HOST=127.0.0.1
# Roles válidos de la empresa, separados por comas (cada grupo pone los de su empresa)
# Roles válidos de la empresa, separados por comas (cada grupo pone los de su empresa)
ROLES=administrador,admisiones,medico
DB_HOST=localhost
DB_PORT=3306
DB_NAME=historias_db
DB_USER=historias_user
DB_PASSWORD=historias_pass
#DEBE SER LA MISMA CLAVE QUE SE USA EN EL MICROSERVICIO ms-usuarios PARA FIRMAR LOS TOKENS.
JWT_SECRET=cambie-esta-frase-por-una-larga-y-secreta

#Dirección del microservicio ms-usuarios (para validar los tokens JWT)
USUARIOS_URL=http://127.0.0.1:3001

#Dirección de ms-pacientes
PACIENTES_URL=http://127.0.0.1:3002

#Dirección de ms-medicos
MEDICOS_URL=http://127.0.0.1:3003
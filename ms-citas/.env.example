# Copie este archivo como .env y ajuste los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# Puerto donde escucha este microservicio (ms-citas = 3004).
PORT=3004
# 127.0.0.1 = solo acepta conexiones desde el mismo equipo (el gateway Apache estará en ese mismo equipo)
HOST=127.0.0.1
# Sedes válidas de MediRed IPS, separadas por comas
SEDES=Bogotá,Cali,Medellín
# Estados válidos de una cita, separados por comas
ESTADOS=programada,atendida,cancelada

# Conexión a MySQL (base de datos propia de este microservicio)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=citas_db
DB_USER=citas_user
DB_PASSWORD=una-clave-segura

# Seguridad JWT: la MISMA frase secreta en todos los microservicios del grupo
JWT_SECRET=cambie-esta-frase-por-una-larga-y-secreta

# URLs de los microservicios que ms-citas consulta (relaciones)
PACIENTES_URL=http://127.0.0.1:3002
MEDICOS_URL=http://127.0.0.1:3003

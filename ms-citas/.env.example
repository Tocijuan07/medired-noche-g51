# Copie este archivo como .env y ajuste los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# Puerto donde escucha este microservicio (ms-citas = 3004).
PORT=3004
# 127.0.0.1 = solo acepta conexiones desde el mismo equipo (el gateway Apache estará en ese mismo equipo)
HOST=127.0.0.1
# Sedes válidas de MediRed IPS, separadas por comas
SEDES=Bogotá,Cali,Medellín
# Estados válidos de una cita, separados por comas
ESTADOS=programada,atendida,cancelada

# Copie este archivo como .env y ajuste los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# Puerto donde escucha este microservicio (ms-citas = 3004)
PORT=3004
# 127.0.0.1 = solo acepta conexiones desde el mismo equipo (Apache, el gateway, está en servidor2)
HOST=127.0.0.1

# Base de datos MySQL de este microservicio
# En su PC: DB_HOST=127.0.0.1 · En servidor2: DB_HOST=10.0.0.242 (MySQL vive en servidor1)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=citas_db
DB_USER=citas_user
DB_PASSWORD=una-clave-segura

# La misma clave que usa ms-usuarios para firmar los tokens JWT
# (el grupo la comparte por un medio privado, nunca en el repositorio)
JWT_SECRET=cambie-esta-frase-por-una-larga-y-secreta

# Direcciones de los microservicios que consulta ms-citas
PACIENTES_URL=http://127.0.0.1:3002
MEDICOS_URL=http://127.0.0.1:3003

# Sedes válidas de MediRed IPS, separadas por comas
SEDES=Bogotá,Cali,Medellín
# Estados válidos de una cita, separados por comas
ESTADOS=programada,atendida,cancelada

{
  "info": {
    "name": "ms-citas",
    "_exporter_id": "g51",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:3004" },
    { "key": "token", "value": "PEGA_AQUI_TU_TOKEN" },
    { "key": "token_medico", "value": "PEGA_AQUI_TOKEN_ROL_MEDICO" }
  ],
  "item": [
    {
      "name": "1 Listar todos",
      "request": {
        "method": "GET",
        "url": { "raw": "{{base_url}}/citas", "host": ["{{base_url}}"], "path": ["citas"] },
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
      }
    },
    {
      "name": "2 Filtrar por sede",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/citas?sede=Bogot%C3%A1",
          "host": ["{{base_url}}"],
          "path": ["citas"],
          "query": [{ "key": "sede", "value": "Bogotá" }]
        },
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
      }
    },
    {
      "name": "4 Obtener un registro existente",
      "request": {
        "method": "GET",
        "url": { "raw": "{{base_url}}/citas/1", "host": ["{{base_url}}"], "path": ["citas", "1"] },
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
      }
    },
    {
      "name": "5 Obtener un id que no existe (404)",
      "request": {
        "method": "GET",
        "url": { "raw": "{{base_url}}/citas/9999", "host": ["{{base_url}}"], "path": ["citas", "9999"] },
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
      }
    },
    {
      "name": "6 Obtener con id no numerico (400)",
      "request": {
        "method": "GET",
        "url": { "raw": "{{base_url}}/citas/abc", "host": ["{{base_url}}"], "path": ["citas", "abc"] },
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
      }
    },
    {
      "name": "7 Crear con datos validos (201)",
      "request": {
        "method": "POST",
        "url": { "raw": "{{base_url}}/citas", "host": ["{{base_url}}"], "path": ["citas"] },
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"paciente_id\": 1,\n  \"medico_id\": 2,\n  \"fecha_hora\": \"2027-12-01T10:00\",\n  \"sede\": \"Cali\",\n  \"estado\": \"programada\"\n}"
        }
      }

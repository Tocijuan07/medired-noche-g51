# Copia de /etc/systemd/system/ms-historias.service (servidor2)
# Instalar:  sudo cp deploy/ms-historias.service /etc/systemd/system/
#            sudo systemctl daemon-reload && sudo systemctl enable --now ms-historias
[Unit]
Description=Microservicio historias - medired
After=network.target

[Service]
User=nodeapps
Group=nodeapps
WorkingDirectory=/srv/medired/app/ms-historias
ExecStart=/usr/bin/node --env-file=.env src/index.js
Restart=on-failure

[Install]
WantedBy=multi-user.target

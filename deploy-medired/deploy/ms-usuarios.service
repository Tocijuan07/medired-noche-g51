# Copia de /etc/systemd/system/ms-usuarios.service (servidor2)
# Instalar:  sudo cp deploy/ms-usuarios.service /etc/systemd/system/
#            sudo systemctl daemon-reload && sudo systemctl enable --now ms-usuarios
[Unit]
Description=Microservicio usuarios - medired
After=network.target

[Service]
User=nodeapps
Group=nodeapps
WorkingDirectory=/srv/medired/app/ms-usuarios-completo/ms-usuarios
ExecStart=/usr/bin/node --env-file=.env src/index.js
Restart=on-failure

[Install]
WantedBy=multi-user.target
